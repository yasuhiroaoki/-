# このファイルを .env.local にコピーして値を入れる（.env.local はgitに含めない）

# アイデア生成用。Anthropic（Claude）のAPIキー。サーバー側でのみ使用する。
ANTHROPIC_API_KEY=sk-ant-...

# メール登録用。Brevoのv3 APIキー。サーバー側でのみ使用する。
BREVO_API_KEY=xkeysib-...

# Brevoの登録先リストID（任意）。設定するとそのリストに連絡先を追加する。
BREVO_LIST_ID=

# LINE友だち追加リンク。公開リンクなのでブラウザ側に出てよい（NEXT_PUBLIC_ 接頭辞）。
NEXT_PUBLIC_LINE_ADD_URL=https://lin.ee/xxxxxxx

# 既存の相続相談LP（出口のテキストリンク）。
NEXT_PUBLIC_LP_URL=https://alfa-consulting.co.jp/sozoku-fudosan-katsuyo/

# GA4 測定ID（任意）。設定すると計測タグを読み込む。
NEXT_PUBLIC_GA_ID=
